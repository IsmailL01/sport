# Phase 5 / Plan 05-07 v2 / D-25 / D-26 — Grafana contact point: Telegram
# Template — deploy script substitutes {{TELEGRAM_BOT_TOKEN}} + {{TELEGRAM_CHAT_ID}} from SOPS.

apiVersion: 1

contactPoints:
  - orgId: 1
    name: telegram-alerts
    receivers:
      - uid: telegram-alerts
        type: telegram
        settings:
          bottoken: '{{TELEGRAM_BOT_TOKEN}}'
          chatid: '{{TELEGRAM_CHAT_ID}}'
          # parse_mode: HTML allows Grafana's default template links to render
          parse_mode: HTML
          disable_notifications: false
          disable_web_page_preview: false
          protect_content: false
