# Скопируйте этот файл в .env и подставьте реальные значения.
# .env находится в .gitignore — НИКОГДА не коммитить.
# Подробнее см. /docs/SECRETS.md
#
# Использование в Dart-коде:
#   const mapboxToken = String.fromEnvironment('MAPBOX_ACCESS_TOKEN');
# Передаётся при сборке через --dart-define:
#   flutter run --dart-define=MAPBOX_ACCESS_TOKEN=$(grep MAPBOX_ACCESS_TOKEN .env | cut -d '=' -f2)

# Mapbox public access token (dev-public, см. SECRETS.md)
MAPBOX_ACCESS_TOKEN=pk.xxx

# Mapbox download token для CocoaPods iOS (~/.netrc).
# Используется один раз при настройке окружения, не передаётся в код.
MAPBOX_DOWNLOAD_TOKEN=sk.xxx
