# Скопируйте этот файл в .env и подставьте реальные значения.
# .env находится в .gitignore — НИКОГДА не коммитить.
# Подробнее см. /docs/SECRETS.md (rotation playbook, classification rules, incident response).

# ── PUBLIC — bundled with app ────────────────────────────────────────────────
# Mapbox public access token (pk.…, dev-public-v2 — см. SECRETS.md).
# Используется в runtime через process.env.EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN.
# Безопасен в bundle ТОЛЬКО при наличии restrictions в Mapbox dashboard:
#   - iOS Bundle ID: com.runningecosystem.mobile
#   - Android SHA-256 fingerprint (debug + production keystore)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-token-here

# ── SECRET — build-time only, NEVER bundled ──────────────────────────────────
# Mapbox secret download token (sk.…, scope DOWNLOADS:READ).
# НЕ должен заканчиваться этим placeholder'ом в реальном .env — реальное
# значение живёт ТОЛЬКО в ~/.netrc (iOS Pods) и ~/.gradle/gradle.properties
# (Android Gradle, в $HOME, mode 600).
# Эта строка в .env.example — документационный stub.
# ⚠️ НЕ добавлять префикс EXPO_PUBLIC_ к этой переменной — иначе Metro
# запакует токен в bundle. ESLint guard (no-restricted-syntax) ловит
# любые `process.env.EXPO_PUBLIC_*_SECRET` обращения на CI.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.replace-via-netrc-or-gradle-do-not-commit
