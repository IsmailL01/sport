# Скопируйте этот файл в .env и подставьте реальные значения.
# .env находится в .gitignore — НИКОГДА не коммитить.
# Подробнее см. /docs/SECRETS.md

# Mapbox public access token (dev-public, см. SECRETS.md)
# Используется в коде через process.env.EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxx

# Mapbox download token (отдельный токен со scope DOWNLOADS:READ)
# Используется CocoaPods (iOS) для скачивания Mapbox SDK через ~/.netrc
# Также подставляется в plugin @rnmapbox/maps в app.json через переменную $RNMAPBOX_MAPS_DOWNLOAD_TOKEN
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.xxx
