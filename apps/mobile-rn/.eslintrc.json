{
  "extends": ["expo"],
  "ignorePatterns": ["/dist/*", "node_modules/", "android/", "ios/"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@rnmapbox/maps",
            "message": "Импорт Mapbox SDK разрешён только из src/map/. См. ТЗ §3 принцип 10."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/map/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
