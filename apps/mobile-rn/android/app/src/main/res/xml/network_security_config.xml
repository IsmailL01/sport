<?xml version="1.0" encoding="utf-8"?>
<!--
  Closed-beta self-hosted backend on srv1561293 (82.25.71.215:8444) uses
  Caddy's local CA (self-signed). Real Let's Encrypt is blocked because
  casino's nginx owns :80/:443 on this host; backlog REAL-CERT-FOR-BACKEND
  for v1.0.1 (DNS-01 with a registrable DNS name).

  Mapbox / Sentry / Expo Updates / any other public-CA TLS keep the
  system trust store via base-config — only our backend hostnames pin to
  the additional CA. This is strictly additive — system CAs still work
  on these domains too in case we later move to LE without rebundling.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </base-config>

  <domain-config includeSubdomains="false">
    <domain>82-25-71-215.sslip.io</domain>
    <domain>s3.82-25-71-215.sslip.io</domain>
    <trust-anchors>
      <certificates src="system"/>
      <certificates src="@raw/caddy_root_ca"/>
    </trust-anchors>
  </domain-config>
</network-security-config>
