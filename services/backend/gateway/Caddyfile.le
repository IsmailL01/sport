# Self-hosted deploy with real Let's Encrypt via DNS-01 (DuckDNS).
# See deploy/SRV1561293.md §«Migrating to real LE certs».
#
# Required env in .env.prod:
#   BACKEND_DOMAIN       — e.g. messenger-am.duckdns.org
#   DUCKDNS_API_TOKEN    — single account-level token from www.duckdns.org
#   CADDY_ACME_EMAIL     — real address (LE rejects .invalid TLD)
#
# DuckDNS subtlety: TXT records can only be set at the apex of the
# duckdns.org subdomain (e.g. _acme-challenge.messenger-am.duckdns.org).
# Per-subdomain DNS-01 (e.g. for s3.messenger-am.duckdns.org) is
# impossible. Workaround: ONE multi-SAN cert covering apex + wildcard,
# obtained in a single ACME order (one TXT set, one verify). Caddy
# achieves this by having both names in the same site block.
#
# Co-tenant invariant: casino nginx owns :80 + :443 — NEVER touch.

{
    admin off
    email {env.CADDY_ACME_EMAIL}
    auto_https disable_redirects
    log {
        output stdout
        format console
        level INFO
    }
}

*.{env.BACKEND_DOMAIN}:8444 {
    tls {
        dns duckdns {env.DUCKDNS_API_TOKEN}
    }

    # MinIO S3-compatible proxy (host-matched). Caddy preserves Host header
    # by default → MinIO signature validation works against the public
    # s3.* hostname.
    @s3 host s3.{env.BACKEND_DOMAIN}
    handle @s3 {
        reverse_proxy minio:9000
    }

    # Anything that's neither s3.* nor api.* → 404 (no accidental exposure).
    @not_api not host api.{env.BACKEND_DOMAIN}
    handle @not_api {
        respond 404
    }

    # ─── API routes — only fire for api.* host (s3.* already returned,
    #     non-api/non-s3 already returned) ───

    @cors_preflight method OPTIONS
    header @cors_preflight Access-Control-Allow-Origin "*"
    header @cors_preflight Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    header @cors_preflight Access-Control-Allow-Headers "Authorization, Content-Type"
    respond @cors_preflight 204

    header Access-Control-Allow-Origin "*"

    handle /healthz {
        respond `{"status":"ok"}` 200
    }

    # Temporary APK download path for closed-beta tester install.
    # Remove after distribution pipeline (MinIO + manifestCheck) is enabled.
    handle_path /downloads/* {
        root * /srv/admin
        file_server
    }

    handle /admin {
        root * /srv/admin
        try_files /index.html
        file_server
    }
    handle /admin/ {
        root * /srv/admin
        try_files /index.html
        file_server
    }
    handle /admin/index.html {
        root * /srv/admin
        file_server
    }

    handle /auth/* {
        reverse_proxy identity:8081
    }
    handle /me {
        reverse_proxy identity:8081
    }
    # Feature flags (public read at /featureflags, admin CRUD at /admin/featureflags
    # — the latter falls through the social-graph /admin/* rule below; identity
    # owns /featureflags and /admin/featureflags per identity http.go:78-82).
    handle /featureflags {
        reverse_proxy identity:8081
    }
    handle /admin/featureflags {
        reverse_proxy identity:8081
    }
    handle /admin/featureflags/* {
        reverse_proxy identity:8081
    }

    handle /sessions {
        reverse_proxy activity-sync:8082
    }
    handle /sessions/* {
        reverse_proxy activity-sync:8082
    }

    handle /devices {
        reverse_proxy notifications:8087
    }
    handle /devices/* {
        reverse_proxy notifications:8087
    }
    handle /notifications {
        reverse_proxy notifications:8087
    }
    handle /notifications/* {
        reverse_proxy notifications:8087
    }
    handle /preferences {
        reverse_proxy notifications:8087
    }

    handle /ws {
        reverse_proxy realtime-gw:8090
    }

    handle /conversations {
        reverse_proxy messaging:8083
    }
    handle /conversations/* {
        reverse_proxy messaging:8083
    }
    handle /messages/* {
        reverse_proxy messaging:8083
    }

    handle /uploads {
        reverse_proxy media:8086
    }
    handle /uploads/* {
        reverse_proxy media:8086
    }
    handle /media/* {
        reverse_proxy media:8086
    }

    handle /stories {
        reverse_proxy feed:8085
    }
    handle /stories/* {
        reverse_proxy feed:8085
    }
    handle /posts {
        reverse_proxy feed:8085
    }
    handle /posts/* {
        reverse_proxy feed:8085
    }
    handle /feed/* {
        reverse_proxy feed:8085
    }

    handle /profiles/* {
        reverse_proxy social-graph:8084
    }
    handle /profiles {
        reverse_proxy social-graph:8084
    }
    handle /search/users {
        reverse_proxy social-graph:8084
    }
    handle /relations/* {
        reverse_proxy social-graph:8084
    }
    handle /follows/* {
        reverse_proxy social-graph:8084
    }
    handle /blocks/* {
        reverse_proxy social-graph:8084
    }
    handle /reports {
        reverse_proxy social-graph:8084
    }
    handle /reports/* {
        reverse_proxy social-graph:8084
    }
    handle /friend-requests {
        reverse_proxy social-graph:8084
    }
    handle /friend-requests/* {
        reverse_proxy social-graph:8084
    }
    handle /admin/* {
        reverse_proxy social-graph:8084
    }

    log {
        output stdout
        format json
    }
}
