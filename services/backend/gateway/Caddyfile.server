# Self-hosted deploy on srv1561293 (82.25.71.215:8444).
# Co-tenant with niko-prod casino (nginx on :80/:443 — NO-TOUCH invariant)
# and observability-stack (caddy on :8443).
#
# Cert via `tls internal` (Caddy's local CA — self-signed). Real Let's Encrypt
# blocked because:
#   - HTTP-01 challenge needs :80 → owned by casino's nginx
#   - TLS-ALPN-01 needs :443 → owned by casino's nginx
#   - DNS-01 needs DNS API → sslip.io has none
# Real cert is a v1.0.1 follow-up — see backlog REAL-CERT-FOR-BACKEND.
#
# Mobile app must accept Caddy root CA on the device. Two options:
#   1. Install root CA as user trust anchor (Android Settings → Security)
#   2. Add network_security_config.xml allowlist (RN bundle)
# Closed-beta with 5-10 testers — option 1 is acceptable for v1.0.

{
	admin off
	auto_https disable_redirects
	log {
		output stdout
		format console
		level INFO
	}
}

# MinIO S3-compatible object storage proxy.
# `tls internal` issues cert for arbitrary DNS names; SNI routes correctly.
# Client uses presigned URLs against this hostname; Caddy preserves Host
# header by default so MinIO signature validation works.
s3.82-25-71-215.sslip.io:8444 {
	tls internal

	reverse_proxy minio:9000

	log {
		output stdout
		format json
	}
}

82-25-71-215.sslip.io:8444 {
	tls internal

	# CORS для будущего веб-клиента.
	@cors_preflight method OPTIONS
	header @cors_preflight Access-Control-Allow-Origin "*"
	header @cors_preflight Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
	header @cors_preflight Access-Control-Allow-Headers "Authorization, Content-Type"
	respond @cors_preflight 204

	header Access-Control-Allow-Origin "*"

	# Gateway own health check (cheap — no upstream).
	handle /healthz {
		respond `{"status":"ok"}` 200
	}

	# Phase L: admin dashboard (static).
	handle /admin {
		root * /srv/admin
		try_files /index.html
		file_server
	}
	handle /admin/ {
		root * /srv/admin
		try_files /index.html
		file_server
	}
	handle /admin/index.html {
		root * /srv/admin
		file_server
	}

	# Identity service (auth/me/profiles bootstrap + OTP).
	handle /auth/* {
		reverse_proxy identity:8081
	}
	handle /me {
		reverse_proxy identity:8081
	}

	# Activity sync (session + points + laps + records).
	handle /sessions {
		reverse_proxy activity-sync:8082
	}
	handle /sessions/* {
		reverse_proxy activity-sync:8082
	}

	# Notifications (Phase A4: devices + in-app + preferences).
	handle /devices {
		reverse_proxy notifications:8087
	}
	handle /devices/* {
		reverse_proxy notifications:8087
	}
	handle /notifications {
		reverse_proxy notifications:8087
	}
	handle /notifications/* {
		reverse_proxy notifications:8087
	}
	handle /preferences {
		reverse_proxy notifications:8087
	}

	# Realtime gateway (WS — Caddy v2 auto-handles upgrade).
	handle /ws {
		reverse_proxy realtime-gw:8090
	}

	# Messaging (DM conversations + messages + outbox).
	handle /conversations {
		reverse_proxy messaging:8083
	}
	handle /conversations/* {
		reverse_proxy messaging:8083
	}
	handle /messages/* {
		reverse_proxy messaging:8083
	}

	# Media (presigned-URL issuance + metadata).
	handle /uploads {
		reverse_proxy media:8086
	}
	handle /uploads/* {
		reverse_proxy media:8086
	}
	handle /media/* {
		reverse_proxy media:8086
	}

	# Feed (stories + posts + likes + comments + home feed).
	handle /stories {
		reverse_proxy feed:8085
	}
	handle /stories/* {
		reverse_proxy feed:8085
	}
	handle /posts {
		reverse_proxy feed:8085
	}
	handle /posts/* {
		reverse_proxy feed:8085
	}
	handle /feed/* {
		reverse_proxy feed:8085
	}

	# Social-graph (profiles + follows + blocks + reports + admin
	# + Phase 10 friend-requests).
	handle /profiles/* {
		reverse_proxy social-graph:8084
	}
	handle /profiles {
		reverse_proxy social-graph:8084
	}
	handle /search/users {
		reverse_proxy social-graph:8084
	}
	handle /relations/* {
		reverse_proxy social-graph:8084
	}
	handle /follows/* {
		reverse_proxy social-graph:8084
	}
	handle /blocks/* {
		reverse_proxy social-graph:8084
	}
	handle /reports {
		reverse_proxy social-graph:8084
	}
	handle /reports/* {
		reverse_proxy social-graph:8084
	}
	# Phase 10 / ADR-0011 Amendment 6 friend-request endpoints.
	# Routes BEFORE /admin/* matcher to keep social-graph priority on
	# /friend-requests vs admin-namespace.
	handle /friend-requests {
		reverse_proxy social-graph:8084
	}
	handle /friend-requests/* {
		reverse_proxy social-graph:8084
	}
	handle /admin/* {
		reverse_proxy social-graph:8084
	}

	log {
		output stdout
		format json
	}
}
